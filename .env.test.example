# Copiar como .env.test en la máquina virtual y completar allí.
# .env.test está ignorado por Git. No versionar secretos reales.

# Red Docker YA EXISTENTE donde deben verse Python, PostgreSQL y gesFactu.
GESFACTU_TEST_DOCKER_NETWORK=CHANGE_ME

# DNS/nombre del servicio o contenedor PostgreSQL dentro de esa red.
GESFACTU_TEST_DB_HOST=CHANGE_ME
GESFACTU_TEST_DB_PORT=5432
GESFACTU_TEST_DB_NAME=gesfactu_verifactu_test
GESFACTU_TEST_DB_USER=gesfactu_verifactu_test
GESFACTU_TEST_DB_PASSWORD=CHANGE_ME

# Host interno esperado al llamar desde Python.
GESFACTU_TEST_ALLOWED_HOSTS=gesfactu-api-test

# Rutas LOCALES de la VM. Los ficheros se montan como Docker secrets.
GESFACTU_TEST_API_KEY_FILE=/opt/gesfactu-test/secrets/api-key.txt
GESFACTU_TEST_ADMIN_KEY_FILE=/opt/gesfactu-test/secrets/admin-key.txt
GESFACTU_TEST_AEAT_PFX_FILE=/opt/gesfactu-test/secrets/aeat-test.pfx
GESFACTU_TEST_AEAT_PFX_PASSWORD_FILE=/opt/gesfactu-test/secrets/aeat-pfx-password.txt

# Obligado tributario de pruebas.
GESFACTU_TEST_TAXPAYER_NIF=CHANGE_ME
GESFACTU_TEST_TAXPAYER_NAME=CHANGE_ME

# Sistema informático.
GESFACTU_TEST_SYSTEM_PRODUCER_NAME=CHANGE_ME
GESFACTU_TEST_SYSTEM_PRODUCER_NIF=CHANGE_ME
GESFACTU_TEST_SYSTEM_NAME=gesFactu
GESFACTU_TEST_SYSTEM_ID=01
GESFACTU_TEST_SYSTEM_VERSION=1.0.0
GESFACTU_TEST_INSTALLATION_NUMBER=test-01
