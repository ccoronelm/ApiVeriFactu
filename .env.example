# Nunca copie secretos reales dentro de este fichero si va a versionarlo.
GESFACTU_ALLOWED_HOSTS=verifactu.internal.example
GESFACTU_ALLOWED_ORIGIN=https://app.example.com
GESFACTU_TRUSTED_PROXY_IP=172.20.0.2
GESFACTU_DOCKER_NETWORK=gesfactu-internal

# Cerrojo deliberado. Cambiar a true sólo tras completar PRODUCTION-CHECKLIST.
GESFACTU_ALLOW_PRODUCTION=false

# PostgreSQL compartido: usar una base y usuario exclusivos para ApiVeriFactu.
GESFACTU_DB_CONNECTION=Host=postgres;Port=5432;Database=gesfactu_verifactu;Username=gesfactu_verifactu;Password=CHANGE_ME

# Rutas LOCALES a secretos. Los ficheros no se copian a la imagen.
GESFACTU_API_KEY_FILE=/secure/gesfactu_api_key.txt
GESFACTU_ADMIN_KEY_FILE=/secure/gesfactu_admin_key.txt
GESFACTU_AEAT_PFX_FILE=/secure/aeat.pfx
GESFACTU_AEAT_PFX_PASSWORD_FILE=/secure/aeat_pfx_password.txt

GESFACTU_TAXPAYER_NIF=CHANGE_ME
GESFACTU_TAXPAYER_NAME=CHANGE_ME
GESFACTU_SYSTEM_PRODUCER_NAME=CHANGE_ME
GESFACTU_SYSTEM_PRODUCER_NIF=CHANGE_ME
GESFACTU_SYSTEM_NAME=gesFactu
GESFACTU_SYSTEM_ID=01
GESFACTU_SYSTEM_VERSION=1.0.0
GESFACTU_INSTALLATION_NUMBER=prod-01
